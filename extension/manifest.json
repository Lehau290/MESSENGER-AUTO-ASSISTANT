{
  "manifest_version": 3,
  "name": "Messenger Auto Assistant - Tự Động Trả Lời AI",
  "version": "1.0.0",
  "description": "Tự động đọc tin nhắn Messenger và dùng AI tự động gõ, tự động gửi phản hồi trực tiếp",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://*.messenger.com/*",
    "https://*.facebook.com/*",
    "http://localhost:5000/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Messenger Auto AI"
  },
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.messenger.com/*",
        "https://*.facebook.com/messages/*"
      ],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ]
}
